generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id            String                   @id @default(uuid())
  name          String
  type          TransactionType
  amount        Decimal                  @db.Decimal(10, 2)
  category      TransactionCategory
  paymentMethod TransactionPaymentMethod
  date          DateTime
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userId        String
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransactionCategory {
  FOOD
  SUBSCRIPTIONS
  EDUCATION
  EMERGENCY
  ENTERTAINMENT
  LOAN
  INVOICE
  INVESTMENTS
  HOUSING
  SALARY
  HEALTH
  TRANSPORTATION
  UTILITY
  CLOTHING
  TRAVEL
  OTHER
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  FOOD_VOUCHER
  OTHER
}

model KeepAlive {
  id        String   @id
  pingCount Int      @default(0)
  pingedAt  DateTime @default(now())
  source    String?
}
