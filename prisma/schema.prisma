generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id            String                   @id @default(uuid())
  name          String
  type          TransactionType
  amount        Decimal                  @db.Decimal(10, 2)
  category      TransactionCategory
  paymentMethod TransactionPaymentMethod
  date          DateTime
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  userId        String

  /// Recorrência que gerou esta transação (nulo para transações avulsas).
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  /// Compra parcelada: todas as parcelas da mesma compra têm o mesmo grupo.
  installmentGroupId String?
  /// Número desta parcela (1 a installmentTotal).
  installmentNumber  Int?
  installmentTotal   Int?

  /// Impede que a mesma recorrência gere duas transações na mesma data.
  @@unique([recurringTransactionId, date])
  @@index([userId, date])
  @@index([installmentGroupId])
}

/// Transação que se repete todo mês (só Premium). As transações de cada mês
/// são criadas automaticamente quando o usuário abre o app; editar a
/// recorrência afeta só os meses ainda não gerados.
model RecurringTransaction {
  id              String                   @id @default(uuid())
  userId          String
  name            String
  type            TransactionType
  amount          Decimal                  @db.Decimal(10, 2)
  category        TransactionCategory
  paymentMethod   TransactionPaymentMethod
  /// Dia do mês (1–31). Em meses mais curtos, usa o último dia.
  dayOfMonth      Int
  startDate       DateTime
  endDate         DateTime?
  /// Data da última transação gerada; a próxima geração começa no mês seguinte.
  lastGeneratedAt DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  transactions    Transaction[]

  @@index([userId, lastGeneratedAt])
}

/// Orçamento mensal por categoria. Dois tipos de registro:
/// - onlyThisMonth = false: vale a partir do mês/ano informado, até ser trocado;
/// - onlyThisMonth = true: vale só naquele mês (substitui o anterior só nele).
/// amount nulo significa "sem orçamento" (permite remover a partir de um mês).
model Budget {
  id            String              @id @default(uuid())
  userId        String
  category      TransactionCategory
  amount        Decimal?            @db.Decimal(10, 2)
  month         Int
  year          Int
  onlyThisMonth Boolean             @default(false)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, category, year, month, onlyThisMonth])
  @@index([userId, year, month])
}

enum TransactionType {
  DEPOSIT
  EXPENSE
  INVESTMENT
}

enum TransactionCategory {
  FOOD
  SUBSCRIPTIONS
  EDUCATION
  EMERGENCY
  ENTERTAINMENT
  LOAN
  INVOICE
  INVESTMENTS
  HOUSING
  SALARY
  HEALTH
  TRANSPORTATION
  UTILITY
  CLOTHING
  TRAVEL
  OTHER
}

enum TransactionPaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  BANK_SLIP
  CASH
  PIX
  FOOD_VOUCHER
  OTHER
}

model KeepAlive {
  id        String   @id
  pingCount Int      @default(0)
  pingedAt  DateTime @default(now())
  source    String?
}

/// Relatórios de IA gerados. Cada geração vira uma linha: o mais recente de
/// cada mês é o exibido, e as linhas das últimas 24h contam para o limite diário.
model AiReport {
  id        String   @id @default(uuid())
  userId    String
  month     Int
  year      Int
  content   String
  model     String
  createdAt DateTime @default(now())

  @@index([userId, year, month, createdAt])
  @@index([userId, createdAt])
}
