# Copie este arquivo para .env e preencha os valores.

# BANCO (Supabase/Postgres) — conexão via pooler (Supavisor)
DATABASE_URL=
# Conexão direta (usada pelo Prisma CLI em migrations, se necessário)
DIRECT_URL=

# CLERK (autenticação)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# STRIPE (assinaturas)
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PLAN_PRICE_ID=
# Segredo do endpoint de webhook (whsec_...). Em dev: saída do `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# URL pública do app, sem barra no final (ex.: http://localhost:3000)
APP_URL=http://localhost:3000

# OPENAI (opcional) — sem ela o relatório de IA retorna um relatório de exemplo
OPENAI_API_KEY=
# Modelo usado no relatório (opcional, padrão gpt-4o-mini)
OPENAI_MODEL=

# KEEPALIVE (opcional) — protege /api/keepalive; a Vercel envia como Bearer token
CRON_SECRET=
