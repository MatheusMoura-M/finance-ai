# Copie este arquivo para .env e preencha os valores.

# BANCO (Supabase/Postgres)
# Usada pelo app: pooler em modo TRANSAÇÃO (porta 6543). O modo sessão (5432)
# aceita só 15 conexões no total e derruba o site na Vercel.
# Ex.: postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# Usada pelo Prisma CLI (migrate, studio): pooler em modo sessão (porta 5432)
# ou conexão direta.
DIRECT_URL=

# CLERK (autenticação)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# STRIPE (assinaturas)
STRIPE_SECRET_KEY=
STRIPE_PREMIUM_PLAN_PRICE_ID=
# Segredo do endpoint de webhook (whsec_...). Em dev: saída do `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# URL pública do app, sem barra no final (ex.: http://localhost:3000)
APP_URL=http://localhost:3000

# OPENAI (opcional) — sem ela o relatório de IA retorna um relatório de exemplo
OPENAI_API_KEY=
# Modelo usado no relatório (opcional, padrão gpt-4o-mini)
OPENAI_MODEL=

# KEEPALIVE — protege /api/keepalive; a Vercel Cron envia como Bearer token.
# Sem ela a rota fica bloqueada (503) e o Supabase pode pausar por inatividade.
CRON_SECRET=
